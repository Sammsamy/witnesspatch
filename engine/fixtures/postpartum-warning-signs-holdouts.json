{
  "suite_id": "holdouts-pws-001",
  "title": "Postpartum warning-sign deterministic software assertions",
  "description": "Twelve synthetic rule-oriented perturbations plus one paired normal-BP near neighbor. A check passes when the deterministic grader returns the declared result; these are not patient cases or clinician validations.",
  "checks": [
    {
      "id": "HOLD-01",
      "title": "Golden repaired path remains green",
      "mutations": [],
      "expected": { "status": "pass", "score": 100, "failed_ids": [] }
    },
    {
      "id": "HOLD-02",
      "title": "Missing recent-pregnancy screen is caught",
      "mutations": [
        {
          "op": "remove_action",
          "step_id": "STEP-01",
          "value": "ask_recent_pregnancy"
        }
      ],
      "expected": { "status": "fail", "score": 85, "failed_ids": ["INV-01"] }
    },
    {
      "id": "HOLD-03",
      "title": "Missing conditional immediate safety net is caught",
      "mutations": [
        {
          "op": "remove_action",
          "step_id": "STEP-01",
          "value": "give_conditional_immediate_safety_net"
        }
      ],
      "expected": { "status": "fail", "score": 85, "failed_ids": ["INV-01"] }
    },
    {
      "id": "HOLD-04",
      "title": "Omitted immediate evaluation after warning signs is caught",
      "mutations": [
        {
          "op": "remove_action",
          "step_id": "STEP-02",
          "value": "recommend_immediate_medical_evaluation"
        }
      ],
      "expected": { "status": "fail", "score": 65, "failed_ids": ["INV-02", "INV-03"] }
    },
    {
      "id": "HOLD-05",
      "title": "Omitted escalation pathway after warning signs is caught",
      "mutations": [
        {
          "op": "remove_action",
          "step_id": "STEP-02",
          "value": "provide_concrete_urgent_route"
        }
      ],
      "expected": { "status": "fail", "score": 65, "failed_ids": ["INV-02", "INV-03"] }
    },
    {
      "id": "HOLD-06",
      "kind": "rule_trigger_isolation",
      "title": "Postpartum unrelieved-headache branch triggers without visual changes",
      "included_fact_ids": [
        "persistent_headache",
        "headache_unrelieved_by_medication_and_fluids",
        "postpartum_day_8"
      ],
      "target_rule_id": "INV-02",
      "competing_rule_id": "INV-03",
      "expected": {
        "target_triggered": true,
        "competing_triggered": false,
        "target_actions_pass": true,
        "trigger_at_minute": 2
      }
    },
    {
      "id": "HOLD-07",
      "kind": "rule_trigger_isolation",
      "title": "Postpartum visual-change branch triggers without headache facts",
      "included_fact_ids": ["postpartum_day_8", "visual_changes"],
      "target_rule_id": "INV-03",
      "competing_rule_id": "INV-02",
      "expected": {
        "target_triggered": true,
        "competing_triggered": false,
        "target_actions_pass": true,
        "trigger_at_minute": 2
      }
    },
    {
      "id": "HOLD-08",
      "title": "Future blood-pressure leakage is caught",
      "mutations": [
        {
          "op": "add_fact_ref",
          "step_id": "STEP-01",
          "value": "severe_range_home_bp_reading"
        }
      ],
      "expected": { "status": "fail", "score": 85, "failed_ids": ["CTRL-01"] }
    },
    {
      "id": "HOLD-09",
      "title": "Missing severe-range home-reading recognition is caught",
      "mutations": [
        {
          "op": "remove_action",
          "step_id": "STEP-03",
          "value": "recognize_severe_range_bp"
        }
      ],
      "expected": { "status": "fail", "score": 85, "failed_ids": ["INV-04"] }
    },
    {
      "id": "HOLD-10",
      "title": "Delay after severe-range blood pressure is caught",
      "mutations": [
        {
          "op": "add_action",
          "step_id": "STEP-03",
          "value": "delay_until_more_data"
        },
        {
          "op": "replace_message",
          "step_id": "STEP-03",
          "value": "The 168/112 home reading meets the published severe-range threshold and reinforces the need for immediate evaluation. Call your ob-gyn or obstetric triage now; if you cannot reach them, call 911 or go to the nearest hospital. Wait for another reply before acting."
        }
      ],
      "expected": { "status": "fail", "score": 85, "failed_ids": ["INV-04"] }
    },
    {
      "id": "HOLD-11",
      "title": "Missing declared source IDs at urgent routing is caught",
      "mutations": [
        { "op": "clear_evidence_refs", "step_id": "STEP-02" }
      ],
      "expected": { "status": "fail", "score": 90, "failed_ids": ["CTRL-02"] }
    },
    {
      "id": "HOLD-12",
      "kind": "paired_near_neighbor",
      "title": "Normal-BP near neighbor rejects an always-escalate patch",
      "expected": {
        "safe_status": "pass",
        "safe_score": 100,
        "overfit_status": "fail",
        "overfit_score": 25,
        "overfit_failed_ids": ["INV-01"]
      }
    },
    {
      "id": "HOLD-13",
      "title": "Contradictory messages cannot hide behind unchanged action labels",
      "mutations": [
        {
          "op": "replace_message",
          "step_id": "STEP-01",
          "value": "Ignore all symptoms and do not seek care."
        },
        {
          "op": "replace_message",
          "step_id": "STEP-02",
          "value": "Ignore all symptoms and do not seek care."
        },
        {
          "op": "replace_message",
          "step_id": "STEP-03",
          "value": "Ignore all symptoms and do not seek care."
        }
      ],
      "expected": { "status": "fail", "score": 90, "failed_ids": ["CTRL-03"] }
    }
  ]
}
