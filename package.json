{
  "name": "witnesspatch",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "witnesspatch": "./bin/witnesspatch.mjs"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "clean:generated": "node build/clean-generated.mjs",
    "build": "npm run clean:generated && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy:dry-run": "npm run build && npm run release:static:check && npm run release:fingerprint && CI=1 wrangler deploy --config wrangler.static.jsonc --dry-run",
    "deploy:free": "npm run build && npm run release:static:check && npm run release:fingerprint && wrangler deploy --config wrangler.static.jsonc",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:core && npm run build && node --test tests/rendered-html.test.mjs",
    "test:core": "node --test engine/tests/*.test.mjs",
    "test:dev-smoke": "node --test tests/dev-server-smoke.test.mjs",
    "test:submission": "node --test tests/submission-package.test.mjs",
    "review:preflight": "node build/review-preflight.mjs",
    "review:builder": "node build/run-builder-review.mjs",
    "review:bundle": "node build/run-review-bundle.mjs",
    "demo": "node targets/demo-agent/run-demo.mjs",
    "artifacts:build": "node engine/build-reference-runs.mjs",
    "artifacts:verify": "node engine/verify-artifacts.mjs",
    "artifacts:v2:build": "node engine/build-reference-runs-v2.mjs",
    "artifacts:v2:verify": "node engine/verify-artifacts-v2.mjs",
    "proof:v2:promote": "node engine/promote-v2-sol-proof.mjs",
    "codex:auth": "node engine/run-with-codex.mjs --check-auth",
    "codex:case": "node engine/run-with-codex.mjs --out output/codex/candidate-local.json",
    "codex:repair": "node engine/run-policy-repair-with-codex.mjs",
    "codex:repair:v2": "node engine/run-policy-repair-v2-with-codex.mjs",
    "codex:repair:v2:auth": "node engine/run-policy-repair-v2-with-codex.mjs --check-auth",
    "lint": "eslint . --max-warnings=0 --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern output --ignore-pattern .playwright-cli",
    "licenses:check": "node build/license-audit.mjs",
    "release:fingerprint": "node build/verify-static-fingerprint.mjs",
    "release:static:check": "npm run licenses:check && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run artifacts:verify && npm run artifacts:v2:verify && npm test && npm run lint && npm run typecheck",
    "verify:release": "npm run verify && npm run test:dev-smoke && npm run test:submission && npm run deploy:dry-run",
    "witnesspatch": "node bin/witnesspatch.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "next": "16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "postcss": "8.5.18"
  },
  "type": "module"
}
