{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://witnesspatch.local/contracts/compiled-witness.schema.json",
  "title": "WitnessPatch compiled static-trace witness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "counterexample_id",
    "generated_at",
    "case_id",
    "source_run_id",
    "target_rule_id",
    "target_rule_title",
    "minimality_label",
    "minimality_scope",
    "selection_policy",
    "target_rerun",
    "target_adapter_invoked",
    "clinical_minimality_claimed",
    "semantic_correctness_claimed",
    "counterfactual_target_behavior_claimed",
    "provenance",
    "starting_fact_count",
    "starting_fact_ids",
    "minimal_fact_count",
    "minimal_fact_ids",
    "removed_fact_ids",
    "failure",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "counterexample_id": {
      "type": "string",
      "pattern": "^static-witness-[a-f0-9]{16}$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "case_id": { "type": "string", "minLength": 1 },
    "source_run_id": { "type": "string", "minLength": 1 },
    "target_rule_id": { "type": "string", "minLength": 1 },
    "target_rule_title": { "type": "string", "minLength": 1 },
    "minimality_label": {
      "const": "contract-cardinality-minimal-static-trace"
    },
    "minimality_scope": { "type": "string", "minLength": 1 },
    "selection_policy": {
      "enum": [
        "explicit_failed_action_invariant",
        "earliest_critical_failed_action_invariant",
        "earliest_failed_action_invariant"
      ]
    },
    "target_rerun": { "const": false },
    "target_adapter_invoked": { "const": false },
    "clinical_minimality_claimed": { "const": false },
    "semantic_correctness_claimed": { "const": false },
    "counterfactual_target_behavior_claimed": { "const": false },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_mode",
        "contains_real_patient_data",
        "clinician_validation",
        "api_key_required",
        "interpretation"
      ],
      "properties": {
        "generation_mode": {
          "const": "deterministic_static_trace_delta_debugging"
        },
        "contains_real_patient_data": { "const": false },
        "clinician_validation": { "const": "pending" },
        "api_key_required": { "const": false },
        "interpretation": { "type": "string", "minLength": 1 }
      }
    },
    "starting_fact_count": { "type": "integer", "minimum": 1 },
    "starting_fact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "minimal_fact_count": { "type": "integer", "minimum": 1 },
    "minimal_fact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "removed_fact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical",
        "triggered_at_minute",
        "missing_actions",
        "forbidden_actions_observed"
      ],
      "properties": {
        "critical": { "type": "boolean" },
        "triggered_at_minute": { "type": "integer", "minimum": 0 },
        "missing_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_actions_observed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "oracle_predicate_reproduced",
        "oracle_one_minimal",
        "oracle_cardinality_minimal",
        "smaller_subsets_checked",
        "smaller_reproducer",
        "removal_checks",
        "reduction_trace",
        "target_reexecuted_per_subset"
      ],
      "properties": {
        "algorithm": { "const": "ddmin-complement-reduction" },
        "oracle_predicate_reproduced": { "const": true },
        "oracle_one_minimal": { "type": "boolean" },
        "oracle_cardinality_minimal": { "type": "boolean" },
        "smaller_subsets_checked": { "type": "integer", "minimum": 0 },
        "smaller_reproducer": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "removal_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "removed_fact",
              "remaining_facts",
              "reproduced",
              "reason"
            ],
            "properties": {
              "removed_fact": { "type": "string", "minLength": 1 },
              "remaining_facts": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "reproduced": { "type": "boolean" },
              "reason": {
                "enum": [
                  "rule_not_triggered",
                  "invariant_failed",
                  "invariant_passed"
                ]
              }
            }
          }
        },
        "reduction_trace": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "granularity",
              "attempted_removal",
              "remaining_count",
              "reproduced"
            ],
            "properties": {
              "granularity": { "type": "integer", "minimum": 2 },
              "attempted_removal": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "remaining_count": { "type": "integer", "minimum": 0 },
              "reproduced": { "type": "boolean" }
            }
          }
        },
        "target_reexecuted_per_subset": { "const": false }
      }
    }
  }
}
