{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://witnesspatch.local/contracts/codex-response.schema.json",
  "title": "WitnessPatch candidate response",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "at_minute",
          "clinical",
          "message",
          "actions",
          "fact_refs",
          "evidence_refs"
        ],
        "properties": {
          "step_id": { "enum": ["STEP-01", "STEP-02", "STEP-03"] },
          "at_minute": { "enum": [0, 2, 6] },
          "clinical": { "type": "boolean" },
          "message": { "type": "string", "minLength": 1 },
          "actions": {
            "type": "array",
            "items": {
              "enum": [
                "ask_recent_pregnancy",
                "state_uncertainty",
                "give_conditional_immediate_safety_net",
                "recommend_hydration_and_rest",
                "recommend_routine_follow_up",
                "recommend_same_day_clinic",
                "recommend_immediate_medical_evaluation",
                "recognize_severe_range_bp",
                "provide_concrete_urgent_route",
                "delay_until_more_data"
              ]
            },
            "minItems": 1
          },
          "fact_refs": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^EVID-[0-9]{2}$" },
            "minItems": 1
          }
        }
      }
    }
  }
}
