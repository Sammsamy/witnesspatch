{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://witnesspatch.local/contracts/run.schema.json",
  "title": "WitnessPatch evaluated run artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "case_sha256",
    "variant",
    "provenance_verification",
    "provenance",
    "decisions",
    "evaluation",
    "audit_log"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string" },
    "case_id": { "type": "string" },
    "case_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "variant": { "enum": ["baseline", "repaired", "candidate"] },
    "provenance_verification": {
      "enum": [
        "unverified_input_declaration",
        "hash_listed_by_external_manifest"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "generation_mode",
        "model_invocation_logged",
        "contains_real_patient_data",
        "clinician_validation",
        "api_key_required"
      ],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "generation_mode": { "type": "string", "minLength": 1 },
        "model_invocation_logged": { "type": "boolean" },
        "contains_real_patient_data": { "const": false },
        "clinician_validation": { "const": "pending" },
        "api_key_required": { "type": "boolean" },
        "model_config_requested": { "type": "string", "minLength": 1 },
        "reasoning_effort_requested": { "type": "string", "minLength": 1 },
        "honesty_note": { "type": "string", "minLength": 1 },
        "target_policy_id": { "type": "string", "minLength": 1 },
        "target_policy_version": { "type": "string", "minLength": 1 },
        "codex_cli_version": { "type": "string", "minLength": 1 },
        "auth_status": { "type": "string", "minLength": 1 },
        "raw_completion_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "step_completion_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "timeline_prefix_invocations": { "type": "integer", "minimum": 0 },
        "future_steps_present_in_prompts": { "type": "boolean" },
        "isolated_working_directory": { "type": "boolean" },
        "model_tools_disabled": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "at_minute",
          "clinical",
          "message",
          "actions",
          "fact_refs",
          "evidence_refs"
        ],
        "properties": {
          "step_id": { "type": "string" },
          "at_minute": { "type": "integer", "minimum": 0 },
          "clinical": { "const": true },
          "message": { "type": "string", "minLength": 1 },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "fact_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_run_id",
        "failure_summary",
        "policy_diff",
        "regression_assertions",
        "review_status"
      ],
      "properties": {
        "parent_run_id": { "type": "string", "minLength": 1 },
        "failure_summary": { "type": "string", "minLength": 1 },
        "policy_diff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": { "type": "string", "minLength": 1 },
            "after": { "type": "string", "minLength": 1 }
          }
        },
        "regression_assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "review_status": {
          "const": "This case passes deterministic evaluation; declared regression assertions and physician validation remain pending."
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "score",
        "pass_threshold",
        "critical_failures",
        "results",
        "metrics"
      ]
    },
    "audit_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["event"],
        "properties": {
          "event": {
            "enum": [
              "case.loaded",
              "decision.recorded",
              "invariant.passed",
              "invariant.failed",
              "repair.metadata_recorded",
              "run.completed"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "variant": { "const": "repaired" } },
        "required": ["variant"]
      },
      "then": {
        "required": ["repair"],
        "properties": {
          "evaluation": {
            "type": "object",
            "properties": { "status": { "const": "pass" } },
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": { "required": ["repair"] },
      "then": {
        "properties": { "variant": { "const": "repaired" } },
        "required": ["variant"]
      }
    }
  ]
}
